{
  "name": "night-owl",
  "productName": "NightOwl",
  "version": "1.0.0",
  "description": "Advanced Markdown editor and presentation app for philosophical writing and teaching",
  "repository": {
    "type": "git",
    "url": "https://github.com/liammagee/night-owl.git"
  },
  "homepage": "https://machinespirits.org",
  "bugs": {
    "url": "https://github.com/liammagee/night-owl/issues"
  },
  "author": {
    "name": "Liam Magee",
    "email": "liam.magee@gmail.com"
  },
  "license": "Apache-2.0",
  "main": "main.js",
  "bin": {
    "nightowl": "bin/nightowl"
  },
  "scripts": {
    "dev": "npm run electron-dev",
    "preelectron": "npm run native:sign",
    "electron": "electron .",
    "preelectron-dev": "npm run native:sign",
    "electron-dev": "electron . --dev",
    "native:rebuild": "electron-rebuild -f -w sqlite3,better-sqlite3,node-pty",
    "native:sign": "node scripts/repair-native-signatures.js",
    "native:repair": "npm run native:rebuild && npm run native:sign",
    "prebuild": "npm run dist:check",
    "build": "electron-builder",
    "predist": "npm run dist:check",
    "dist": "electron-builder --publish=never",
    "dist:dir": "npm run dist:check && electron-builder --dir --publish=never",
    "dist:check": "npm run presentation:check && node scripts/check-distribution-readiness.js",
    "harness": "node scripts/serve-harness.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:basic": "jest --testPathPattern=tests/unit --testNamePattern=basic",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "node scripts/run-electron-e2e.js",
    "test:e2e:optional": "node scripts/run-electron-e2e.js --config playwright.optional.config.js",
    "test:e2e:packaged": "node scripts/run-electron-e2e.js --config playwright.packaged.config.js",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:watch": "jest --watch",
    "ci:local": "node scripts/local-ci.js",
    "ci:local:release": "node scripts/local-ci.js --release",
    "ci:hook:install": "node scripts/install-local-ci-hook.js",
    "ci:hook:uninstall": "node scripts/install-local-ci-hook.js --uninstall",
    "thumbnail": "node scripts/generate-thumbnail.mjs",
    "quality": "npm run quality:static && npm run wp:check && npm run quality:metrics -- HEAD~1 WORKTREE",
    "quality:static": "node scripts/quality-static-checks.js",
    "quality:metrics": "node scripts/quality-metrics.js",
    "quality:trace": "node scripts/compare-chromium-traces.js",
    "benchmark:performance": "node scripts/run-electron-e2e.js --config playwright.performance.config.js",
    "presentation:build": "node scripts/build-presentations.js",
    "presentation:check": "node scripts/build-presentations.js --check",
    "wp:list": "node scripts/workplan.js list",
    "wp:validate": "node scripts/workplan.js validate",
    "wp:render": "node scripts/workplan.js render",
    "wp:check": "node scripts/workplan.js check",
    "cli:install": "node scripts/install-nightowl-cli.js",
    "cli:uninstall": "node scripts/install-nightowl-cli.js --uninstall",
    "feed-cli": "node scripts/feed-cli.js",
    "feed-mcp": "node scripts/feed-mcp-server.js"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@machinespirits/tutor-core": "https://github.com/liammagee/machinespirits-tutor-core/archive/321b9d21686c3cf4d9395524e569fe21ffd40361.tar.gz",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.11.0",
    "cheerio": "^1.1.2",
    "dictionary-en": "^4.0.0",
    "dompurify": "^3.4.13",
    "dotenv": "^16.4.5",
    "lucide-react": "^0.523.0",
    "marked": "^16.2.0",
    "monaco-editor": "^0.52.2",
    "node-fetch": "^3.3.2",
    "node-pty": "^1.1.0",
    "nspell": "^2.1.5",
    "openai": "^6.9.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.54",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sqlite3": "^5.1.7",
    "write-good": "^1.0.8"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@playwright/test": "^1.55.0",
    "@types/jest": "^29.5.8",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "axe-playwright": "^2.1.0",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "electron-reload": "^2.0.0-alpha.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "playwright": "^1.55.0",
    "tsx": "^4.20.3"
  },
  "build": {
    "appId": "com.machinespirits.nightowl",
    "productName": "NightOwl",
    "copyright": "Copyright © 2024-2025 Liam Magee",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-ipc-guard.js",
      "speaker-notes-preload.js",
      "index.html",
      "styles.css",
      "bin/**/*",
      "css/**/*",
      "js/**/*",
      "ipc/**/*",
      "orchestrator/**/*",
      "plugins/**/*",
      "services/**/*",
      "!node_modules/@machinespirits/tutor-core/.claude{,/**/*}",
      "!node_modules/@machinespirits/tutor-core/.github{,/**/*}",
      "!node_modules/@machinespirits/tutor-core/.npmignore",
      "!node_modules/@machinespirits/tutor-core/CHANGELOG.md",
      "!node_modules/@machinespirits/tutor-core/package-lock.json",
      "!node_modules/@machinespirits/tutor-core/services/__tests__{,/**/*}",
      "!node_modules/@machinespirits/tutor-core/vitest.config.js",
      "vs/**/*",
      "lib/**/*",
      "lectures/**/*",
      "docs/**/*"
    ],
    "extraResources": [
      {
        "from": ".env.example",
        "to": ".env.example"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Education"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "liammagee",
      "repo": "night-owl"
    }
  }
}
