{
  "name": "night-owl",
  "productName": "NightOwl",
  "version": "1.0.0",
  "description": "Advanced Markdown editor and presentation app for philosophical writing and teaching",
  "repository": {
    "type": "git",
    "url": "https://github.com/liammagee/night-owl.git"
  },
  "homepage": "https://machinespirits.org",
  "bugs": {
    "url": "https://github.com/liammagee/night-owl/issues"
  },
  "author": {
    "name": "Liam Magee",
    "email": "liam.magee@gmail.com"
  },
  "license": "Apache-2.0",
  "main": "main.js",
  "scripts": {
    "dev": "npm run electron-dev",
    "preelectron": "npm run native:sign",
    "electron": "electron .",
    "preelectron-dev": "npm run native:sign",
    "electron-dev": "electron . --dev",
    "native:rebuild": "electron-rebuild -f -w sqlite3,better-sqlite3",
    "native:sign": "node scripts/repair-native-signatures.js",
    "native:repair": "npm run native:rebuild && npm run native:sign",
    "build": "electron-builder",
    "dist": "electron-builder --publish=never",
    "harness": "node scripts/serve-harness.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:basic": "jest --testPathPattern=tests/unit --testNamePattern=basic",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:watch": "jest --watch",
    "thumbnail": "node scripts/generate-thumbnail.mjs",
    "quality": "npm run quality:static && npm run quality:metrics -- HEAD~1 WORKTREE",
    "quality:static": "node scripts/quality-static-checks.js",
    "quality:metrics": "node scripts/quality-metrics.js",
    "quality:trace": "node scripts/compare-chromium-traces.js",
    "feed-cli": "node scripts/feed-cli.js",
    "feed-mcp": "node scripts/feed-mcp-server.js",
    "sync-plugins": "sync-techne-plugins",
    "postinstall": "sync-techne-plugins || true"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@google/genai": "^1.16.0",
    "@machinespirits/tutor-core": "file:../machinespirits-tutor-core",
    "axios": "^1.11.0",
    "cheerio": "^1.1.2",
    "dictionary-en": "^4.0.0",
    "dotenv": "^16.4.5",
    "lucide-react": "^0.523.0",
    "marked": "^16.2.0",
    "monaco-editor": "^0.52.2",
    "node-fetch": "^3.3.2",
    "nspell": "^2.1.5",
    "openai": "^4.76.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.54",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sqlite3": "^5.1.7",
    "write-good": "^1.0.8"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@machinespirits/techne-plugins": "file:../../techne-plugins",
    "@playwright/test": "^1.55.0",
    "@types/jest": "^29.5.8",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "axe-playwright": "^2.1.0",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "electron-reload": "^2.0.0-alpha.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "playwright": "^1.55.0",
    "tsx": "^4.20.3"
  },
  "build": {
    "appId": "com.machinespirits.nightowl",
    "productName": "NightOwl",
    "copyright": "Copyright © 2024-2025 Liam Magee",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "speaker-notes-preload.js",
      "index.html",
      "styles.css",
      "css/**/*",
      "js/**/*",
      "ipc/**/*",
      "orchestrator/**/*",
      "plugins/**/*",
      "services/**/*",
      "vs/**/*",
      "lib/**/*",
      "lectures/**/*",
      "docs/**/*"
    ],
    "extraResources": [
      {
        "from": ".env.example",
        "to": ".env.example"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Education"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "liammagee",
      "repo": "night-owl"
    }
  }
}
