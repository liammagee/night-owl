#!/usr/bin/env node

const fs = require('fs');
const path = require('path');
const { execFileSync, spawn } = require('child_process');
const { absolutizeCliPathArgs, parseNightOwlLaunchArgs } = require('../services/launchArgs');
const {
  appendWorkspaceProfileArgs,
  getDefaultUserDataPath
} = require('../services/cliWorkspaceProfile');

const appRoot = path.resolve(__dirname, '..');
const packageJson = require(path.join(appRoot, 'package.json'));
const rawArgs = process.argv.slice(2);
const parsed = parseNightOwlLaunchArgs(rawArgs, { cwd: process.cwd() });

function printUsage() {
  console.log(`NightOwl CLI

Usage:
  nightowl [path]
  nightowl .
  nightowl path/to/file.md

Options:
  -h, --help       Show this help.
  -v, --version    Show the NightOwl version.
  --foreground     Keep the launcher attached to the app process.

Environment:
  NIGHTOWL_CLI_DEV=1      Force the local Electron checkout.
  NIGHTOWL_USER_DATA_DIR=... Base directory for workspace-scoped app profiles.
  NIGHTOWL_APP_PATH=...   macOS .app bundle path to launch.`);
}

if (parsed.help) {
  printUsage();
  process.exit(0);
}

if (parsed.version) {
  console.log(packageJson.version || '0.0.0');
  process.exit(0);
}

const args = absolutizeCliPathArgs(rawArgs, { cwd: process.cwd() }).filter(arg => arg !== '--foreground');
const foreground = rawArgs.includes('--foreground');
const env = { ...process.env };
delete env.ELECTRON_RUN_AS_NODE;

function resolveMacAppPath() {
  if (process.platform !== 'darwin') return '';

  const candidates = [
    process.env.NIGHTOWL_APP_PATH,
    '/Applications/NightOwl.app'
  ].filter(Boolean);

  for (const candidate of candidates) {
    if (fs.existsSync(candidate)) return candidate;
  }

  try {
    const appPath = execFileSync('osascript', [
      '-e',
      'POSIX path of (path to application "NightOwl")'
    ], {
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'ignore'],
      timeout: 2000
    }).trim().replace(/\/$/, '');
    if (appPath && fs.existsSync(appPath)) return appPath;
  } catch (_) {
    // Launch Services may not know NightOwl yet on a fresh source checkout.
  }

  const localAppCandidates = [
    path.join(appRoot, 'dist', process.arch === 'arm64' ? 'mac-arm64' : 'mac', 'NightOwl.app'),
    path.join(appRoot, 'dist', 'mac-universal', 'NightOwl.app'),
    path.join(appRoot, 'dist', 'mac', 'NightOwl.app'),
    path.join(appRoot, 'dist', 'mac-arm64', 'NightOwl.app')
  ];
  for (const candidate of localAppCandidates) {
    if (fs.existsSync(candidate)) return candidate;
  }

  return '';
}

function resolveMacAppExecutable(appPath) {
  if (!appPath) return '';

  const macosDir = path.join(appPath, 'Contents', 'MacOS');
  const preferredExecutable = path.join(macosDir, 'NightOwl');
  if (fs.existsSync(preferredExecutable)) return preferredExecutable;

  try {
    const executable = fs.readdirSync(macosDir)
      .map(entry => path.join(macosDir, entry))
      .find(candidate => {
        try {
          fs.accessSync(candidate, fs.constants.X_OK);
          return fs.statSync(candidate).isFile();
        } catch (_) {
          return false;
        }
      });
    return executable || '';
  } catch (_) {
    return '';
  }
}

function spawnAndExit(command, commandArgs, options = {}) {
  const child = spawn(command, commandArgs, {
    cwd: options.cwd || appRoot,
    env,
    stdio: foreground ? 'inherit' : 'ignore',
    detached: !foreground
  });

  child.on('error', (error) => {
    console.error(`nightowl: failed to launch NightOwl: ${error.message}`);
    process.exit(1);
  });

  if (!foreground) {
    child.unref();
    return;
  }

  child.on('exit', (code, signal) => {
    if (signal) process.kill(process.pid, signal);
    process.exit(code || 0);
  });
}

const electronBin = process.platform === 'win32'
  ? path.join(appRoot, 'node_modules', '.bin', 'electron.cmd')
  : path.join(appRoot, 'node_modules', '.bin', 'electron');
const forceLocal = process.env.NIGHTOWL_CLI_DEV === '1';
const macAppPath = forceLocal ? '' : resolveMacAppPath();
const appArgs = appendWorkspaceProfileArgs(args, {
  baseUserDataPath: process.env.NIGHTOWL_USER_DATA_DIR || getDefaultUserDataPath('NightOwl'),
  cliPaths: parsed.paths,
  cwd: process.cwd()
});

const preferLocal = forceLocal || !macAppPath;

if (preferLocal && fs.existsSync(electronBin)) {
  spawnAndExit(electronBin, [appRoot, ...appArgs]);
  return;
}

if (process.platform === 'darwin') {
  const appPath = macAppPath || process.env.NIGHTOWL_APP_PATH || '/Applications/NightOwl.app';
  if (fs.existsSync(appPath)) {
    const appExecutable = resolveMacAppExecutable(appPath);
    if (appExecutable) {
      spawnAndExit(appExecutable, appArgs, { cwd: process.cwd() });
      return;
    }

    spawnAndExit('open', ['-n', appPath, '--args', ...appArgs], { cwd: process.cwd() });
    return;
  }

  spawnAndExit('open', ['-n', '-a', 'NightOwl', '--args', ...appArgs], { cwd: process.cwd() });
  return;
}

console.error('nightowl: no local Electron checkout or installed NightOwl app was found.');
console.error('nightowl: run from the NightOwl checkout, install the app, or set NIGHTOWL_APP_PATH.');
process.exit(1);
